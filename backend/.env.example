# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=campusfind
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-postgres-password
DB_HOST=localhost
DB_PORT=5432

# CORS: comma-separated origins for the local frontend
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
